      "type": "PARAGRAPH",
      "id": "c02n0",
      "nodes": [
        {
          "type": "TEXT",
          "textData": {
            "text": "The right frequency for manual lymphatic drainage depends on why you are considering it. Routine relaxation, diagnosed lymphedema and recovery after a procedure are different situations and should not share one automatic treatment schedule.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c02s1",
      "nodes": [],
      "paragraphData": {}
    },
    {
