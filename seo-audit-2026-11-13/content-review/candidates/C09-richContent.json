      "nodes": [
        {
          "type": "TEXT",
          "textData": {
            "text": "Manual lymphatic drainage, often shortened to MLD, uses specialized light techniques. It is different from deep-pressure massage and should be chosen for a clear reason rather than as a universal detox service.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c09s1",
      "nodes": [],
      "paragraphData": {}
    },
