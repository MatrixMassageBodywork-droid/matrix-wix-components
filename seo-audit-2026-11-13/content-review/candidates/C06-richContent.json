      "id": "c06n13",
      "nodes": [
        {
          "type": "TEXT",
          "textData": {
            "text": "Explore ",
            "decorations": []
          }
        },
        {
          "type": "TEXT",
          "textData": {
            "text": "red light therapy in Salem",
            "decorations": [
              {
                "type": "LINK",
