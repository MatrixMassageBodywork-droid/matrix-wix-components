          }
        },
        {
          "type": "TEXT",
          "textData": {
            "text": " for Matrix’s current service information. Choose a wellness visit around your preferences without treating it as a replacement for medical care.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
