textData":{"text":"Combining both gives you layered therapeutic effects that a single wavelength can’t match.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"64nwy30","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"o3jhp31","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✅ ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"7fb2m33","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Deeper Healing & Better Penetration","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"y3ja736","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"hunrg37","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Red Light: Absorbed by skin and upper dermis.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"l34k839","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"NIR Light: Penetrates up to 5 cm into tissues.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"ifeax41","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"6z3c542","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Studies show NIR can reach muscles and stimulate healing where Red Light alone can’t. [1]","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"maet046","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"8ajgd47","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✅ ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"07r4d49","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Enhanced Collagen Production","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"kyyod52","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"e5l5h53","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Red and NIR both boost fibroblast activity, which increases collagen — key for firm, youthful skin. Research published in Seminars in Cutaneous Medicine and Surgery shows visible wrinkle reduction with regular use. [2]","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"0yp9357","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"tmihd58","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✅ ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"inda160","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Reduces Fine Lines & Wrinkles","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"k7f0p63","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"mcl2g64","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"By stimulating ATP production in skin cells, red light helps repair photoaged skin. When combined with NIR, the deeper tissues get a boost too, making the effect longer-lasting. [3]","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"of0it68","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"ponj769","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"✅ ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"}}},{"type":"HEADING","id":"9kjpo71","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Speeds Up Muscle Recovery","decorations":[]}}],"headingD