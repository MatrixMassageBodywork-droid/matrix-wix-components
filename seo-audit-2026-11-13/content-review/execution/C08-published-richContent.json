{
  "nodes": [
    {
      "type": "PARAGRAPH",
      "id": "c08n0",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "Burning, tingling, numbness and radiating pain can make everyday tasks difficult. They can also arise for different reasons. Finding the cause is the first step; a wellness service should not be presented as a diagnosis or a cure for nerve damage.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c08s1",
      "nodes": [],
      "paragraphData": {}
    },
    {
