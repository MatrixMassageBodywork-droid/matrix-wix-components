                    "url": "https://www.matrixmassage.net/supplements",
                    "target": "SELF"
                  }
                }
              }
            ]
          }
        },
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": " provides access information; it is not a substitute for that assessment.",
            "decorations": []
