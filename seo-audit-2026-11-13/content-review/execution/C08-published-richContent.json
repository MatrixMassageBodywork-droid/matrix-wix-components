              "nodes": [],
              "textData": {
                "text": "Illustration of the lower spine and sciatic nerve. This is educational imagery, not a depiction of a treatment outcome.",
                "decorations": []
              }
            }
          ]
        }
      ],
      "imageData": {
        "containerData": {
          "width": {
            "size": "CONTENT"
          },
