        "altText": "Illustration of a massage session in a softly lit room",
        "caption": "Massage and muscle comfort"
      }
    },
    {
      "type": "PARAGRAPH",
      "id": "c14spwqa5n1995",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14n4",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "A randomized trial in adults with nonspecific chronic low-back pain found improvements in symptoms and function after a course of massage. That supports a focused discussion about certain pain concerns; it does not establish that massage treats every cause of pain.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s5",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14n5",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "Tell your therapist where you feel discomfort, which activities bother you and what healthcare guidance you have received. Pressure and positioning can then be selected around a meaningful goal.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s6",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "HEADING",
      "id": "c14n6",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "Recovery after activity",
            "decorations": []
          }
        }
      ],
      "headingData": {
        "level": 2
      }
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s7",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "IMAGE",
      "id": "bt7kk318",
      "nodes": [
        {
          "type": "CAPTION",
          "id": "cbbu5400",
          "nodes": [
            {
              "type": "TEXT",
              "id": "",
              "nodes": [],
              "textData": {
                "text": "Making time for rest after activity",
                "decorations": []
              }
            }
          ]
        }
      ],
      "imageData": {
        "containerData": {
          "width": {
            "size": "CONTENT"
          },
          "alignment": "CENTER",
          "textWrap": true
        },
        "image": {
          "src": {
            "id": "e4cc43_980b7a2ca24d45359e6eb446d83e28b5~mv2.png"
