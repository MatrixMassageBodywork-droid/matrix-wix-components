        },
        "altText": "Woman receiving a massage in Salem, WI on a bed in a serene room, blue art on walls. Text: \"De-Stress & Unwind,\" \"Matrix Massage & Bodywork,\" contact info.",
        "caption": "Massage Appointments Salem / Paddock Lake, WI "
      }
    },
    {
      "type": "PARAGRAPH",
      "id": "c14sps8te4856",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14n2",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "Massage gives you time to pause and communicate what feels comfortable. Small clinical studies have explored anxiety-related outcomes, but their results should not be stretched into a guarantee that massage corrects hormones or replaces mental-health care.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s3",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "HEADING",
      "id": "c14n3",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "Muscle comfort and pain",
            "decorations": []
          }
        }
      ],
      "headingData": {
        "level": 2
      }
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s4",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "IMAGE",
      "id": "wqa5n1995",
      "nodes": [
        {
          "type": "CAPTION",
          "id": "38uz82016",
          "nodes": [
            {
              "type": "TEXT",
              "id": "",
              "nodes": [],
              "textData": {
                "text": "Massage and muscle comfort",
                "decorations": []
              }
            }
          ]
        }
      ],
      "imageData": {
        "containerData": {
          "width": {
            "size": "CONTENT"
          },
          "alignment": "CENTER",
          "textWrap": true
        },
        "image": {
          "src": {
            "id": "e4cc43_969e19180fff4dfabb060c37aca6abbc~mv2.png"
