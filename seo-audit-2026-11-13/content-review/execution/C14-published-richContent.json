{
  "nodes": [
    {
      "type": "PARAGRAPH",
      "id": "c14n0",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "A good massage starts with a useful goal. You may want a quiet hour, attention to tense shoulders or a comfortable way to care for muscles after a demanding week. Research can help frame those choices without turning every session into a promise of a medical result.",
            "decorations": []
          }
        }
      ],
      "paragraphData": {}
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s1",
      "nodes": [],
      "paragraphData": {}
    },
    {
      "type": "HEADING",
      "id": "c14n1",
      "nodes": [
        {
          "type": "TEXT",
          "id": "",
          "nodes": [],
          "textData": {
            "text": "Relaxation and stress",
            "decorations": []
          }
        }
      ],
      "headingData": {
        "level": 2
      }
    },
    {
      "type": "PARAGRAPH",
      "id": "c14s2",
      "nodes": [],
      "paragraphData": {}
    },
    {
