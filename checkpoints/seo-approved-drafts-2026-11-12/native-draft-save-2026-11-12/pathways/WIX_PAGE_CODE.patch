+  const definesEntity = Object.keys(value).some(key => key !== '@id' && key !== '@context');
+  if (definesEntity && reservedIds.includes(value['@id'])) return true;
+  const types = Array.isArray(value['@type']) ? value['@type'] : [value['@type']];
+  const pageScopedType = types.some(type => ['WebPage', 'Service', 'BreadcrumbList'].includes(type));
+  if (pageScopedType && (!value.url || value.url === canonicalUrl ||
+      (typeof value['@id'] === 'string' && value['@id'].startsWith(canonicalUrl + '#')))) return true;
+  return Object.keys(value).some(key => hasPathwaySchemaConflict(value[key], canonicalUrl));
