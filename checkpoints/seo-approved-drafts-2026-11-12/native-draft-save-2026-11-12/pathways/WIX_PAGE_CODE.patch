+// Wix requires reading structuredData outside onReady (captured above) and
+// setting it inside onReady (through applyPathwaySeo). The setter replaces the
+// entire array, so retain existing entries and stop on conflicting page schema.
+async function applyPathwayStructuredData(page) {
+  try {
+    const graph = buildPathwayStructuredData(page);
+    if (!graph) return;
+    const retained = originalStructuredData == null ? [] : originalStructuredData;
+    if (!Array.isArray(retained) || retained.some(entry => !entry || typeof entry !== 'object' || Array.isArray(entry))) {
+      throw new Error('Unexpected existing structured-data format; preserve it for review.');
+    }
+    if (retained.some(entry => hasPathwaySchemaConflict(entry, page.canonicalUrl))) {
+      throw new Error('Existing page-specific structured data requires reconciliation before adding the pathway graph.');
+    }
+    await wixSeoFrontend.setStructuredData(retained.concat([graph]));
+  } catch (error) {
+    // A schema issue must not disrupt existing page content or other SEO fields.
+    console.warn('Matrix pathway structured data was not changed:', error && error.message ? error.message : error);
+  }
